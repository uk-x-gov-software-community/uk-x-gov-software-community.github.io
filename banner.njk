{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
{% set html %}
  <p class="govuk-notification-banner__heading">
    2026 AGM Announced
  </p>
  <p class="govuk-notification-banner__body">
    <strong> Our AGM will be held on 10th December 2026. If you wish to nominate yourself for the management committee, please do so before the closing date.
      Nominations close at 12:00 on Monday 7 December 2026. Go to <a class="govuk-notification-banner__link" href="/nominations/">nominations page</a> to submit your nomination.
    </strong>
  </p>
{% endset %}

{{ govukNotificationBanner({
  html: html
}) }}
    </div>
</div>