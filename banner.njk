{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
{% set html %}
  <p class="govuk-notification-banner__heading">
    2026 Conferences Announced
  </p>
  <p class="govuk-notification-banner__body">
    <strong>GovDev North (Newcastle, 30 Sept) and GovDev Midlands (Nottingham, 21 Oct) — register your interest now. <a class="govuk-notification-banner__link" href="/blog/2026/07/govdev-conferences-2026">Read the conference blog post</a>.</strong>
  </p>
{% endset %}

{{ govukNotificationBanner({
  html: html
}) }}
    </div>
</div>